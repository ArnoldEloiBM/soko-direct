rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Auth (Samuel): a user's own profile document. Registration writes
    // this once; the owner can update their own profile afterward.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Transactions (Samuel): read-only from the client today — only the
    // buyer or farmer on the transaction may read it. Writes are expected
    // to land here once "confirm transaction" / "confirm delivery" are
    // built; until then, disallow client writes entirely rather than
    // leaving them open.
    match /transactions/{transactionId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    match /listings/{listingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'sellerId',
          'cropType',
          'pricePerKg',
          'quantityKg',
          'availableFrom',
          'location',
          'photoUrl',
          'status',
          'offerCount',
          'createdAt',
        ]);

      allow update, delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }

    // TODO(team): offers, ratings, and wallet collections don't have rules
    // yet — whoever owns each of those should add a `match` block here
    // scoped to "only the buyer/seller/owner can read or write their own
    // data", following the pattern above.
  }
}
